{
  "skill": "rotless-github-research",
  "verified": {
    "date": "2026-11-02",
    "note": "gh 2.103.3; selftest --quick passes; agent-agnostic wording, argument-hint removed"
  },
  "deps": [
    {
      "type": "cli",
      "name": "gh",
      "tested": "2.103.3",
      "upstream": "github:cli/cli",
      "needs": [
        "api",
        "discussion list",
        "extension list",
        "extension search",
        "issue list",
        "release list",
        "repo clone",
        "repo list",
        "repo read-dir",
        "repo read-file",
        "search code",
        "search commits",
        "search issues",
        "search repos",
        "skill search"
      ]
    },
    {
      "type": "command",
      "id": "selftest",
      "run": "python scripts/selftest.py --quick --json",
      "why": "the skill's own canaries for its gh search rules and its scripts (endpoint shapes are checked below, declaratively)"
    },
    {
      "type": "mcp",
      "url": "https://mcp.grep.app",
      "expectTools": {
        "searchGitHub": [
          "query",
          "useRegexp",
          "language",
          "path",
          "repo",
          "matchCase",
          "matchWholeWords"
        ]
      }
    },
    {
      "type": "http",
      "id": "npm",
      "url": "https://registry.npmjs.org/-/v1/search?text=kubernetes&size=1",
      "expect": {
        "jsonPaths": [
          "total",
          "objects[].package.name",
          "objects[].package.links"
        ]
      }
    },
    {
      "type": "http",
      "id": "crates",
      "url": "https://crates.io/api/v1/crates?q=kubernetes&per_page=1",
